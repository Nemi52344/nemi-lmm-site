# Copy this file to ".env" and fill in the values, then restart the server.
# .env is gitignored, so your keys never get committed or pushed.
#
#   cp .env.example .env      (or just copy/paste the file in Explorer)
#   node serve.js
#
# With RESEND_API_KEY set, localhost sends REAL OTP emails, exactly like production.
# Without it, the server runs in dev mode and shows the code on screen instead.

# --- required for real emails ---
RESEND_API_KEY=

# --- required to sign the OTP tokens (any long random string) ---
OTP_SECRET=local-dev-secret

# --- optional ---
# Sender identity. The domain must be verified in your Resend account.
OTP_FROM=NEMI <info@nemi-ai.com>
# Where form submissions are emailed.
NOTIFY_TO=info@nemi-ai.com

# --- optional: store submissions in Supabase as well as emailing them ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
