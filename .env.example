# Copy this file to ".env" and fill in the values, then restart the server.
# .env is gitignored, so your keys never get committed or pushed.
#
#   cp .env.example .env      (or just copy/paste the file in Explorer)
#   node serve.js
#
# With RESEND_API_KEY set, localhost sends REAL OTP emails, exactly like production.
# Without it, the server runs in dev mode and shows the code on screen instead.

# --- required for real emails ---
RESEND_API_KEY=

# --- required to sign the OTP tokens (any long random string) ---
OTP_SECRET=local-dev-secret

# --- optional ---
# Sender identity. The domain must be verified in your Resend account.
OTP_FROM=NEMI <info@nemilmm.com>
# Where form submissions are emailed.
NOTIFY_TO=info@nemilmm.com

# --- Supabase ---
# SUPABASE_URL + SUPABASE_ANON_KEY are REQUIRED when email verification runs
# through Supabase Auth (the current setup): the server calls /auth/v1/user to
# confirm the visitor's token really belongs to the address being submitted.
# Without them every submission is rejected as "unverified".
# These two are the same values as in assets/js/nemi-config.js — not secrets.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional, and SECRET — only needed to also store submissions + attachments.
# Never put this one in nemi-config.js or any browser-side file.
SUPABASE_SERVICE_KEY=
